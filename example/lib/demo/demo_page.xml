<DemoPage controller="DemoController"
    xmlns:demo_widgets="package:xml_layout_demo/demo/demo_widgets.dart"
    xmlns:playground="package:xml_layout_demo/demo/live_xml_playground.dart">
  <Scaffold>
    <appBar>
      <AppBar>
        <title>
          <Text text="'XML Layout for Flutter — Demo'" />
        </title>
      </AppBar>
    </appBar>
    <body>
      <SingleChildScrollView :padding="16">
        <Column crossAxisAlignment="stretch">

          <DemoHero />

          <LiveXmlPlayground />

          <DemoSection title="'1. Wrapper properties'" icon="Icons.auto_awesome" xml="ctrl.wrappersXml"
              description="':xxx 前缀的包装属性会自动给 widget 套上 Padding / Opacity / Visibility / SizedBox / Align / Transform / Theme 等容器。'">
            <Column crossAxisAlignment="stretch">
              <Row>
                <Container :margin="4" width="86" height="42" color="Colors.indigo.shade100">
                  <Text text="':margin'" />
                </Container>
                <Container :padding="10" color="Colors.teal.shade100">
                  <Text text="':padding'" />
                </Container>
              </Row>
              <Row :margin="8 0 0 0">
                <Text :opacity="0.45" text="':opacity 0.45'" />
                <Text :margin="0 0 0 12" :visible="ctrl.showSecondStream | stream:true" text="':visible'" />
                <Container :margin="0 0 0 12" :width="74" :height="30" color="Colors.amber">
                  <Text text="':w / :h'" />
                </Container>
              </Row>
              <Row :margin="8 0 0 0">
                <Container :margin="4" :scale="1.15" width="44" height="44" color="Colors.pink.shade100">
                  <Text text="':scale'" />
                </Container>
                <Container :margin="4" :rotate="0.15" width="44" height="44" color="Colors.orange.shade100">
                  <Text text="':rotate'" />
                </Container>
                <Container :margin="4" :translate="Offset(0, -4)" width="44" height="44" color="Colors.green.shade100">
                  <Text text="':translate'" />
                </Container>
                <SizedBox :margin="4" width="44">
                  <Container :aspectRatio="1.2" color="Colors.purple.shade100">
                    <Text text="':aspect'" />
                  </Container>
                </SizedBox>
              </Row>
              <Row :margin="8 0 0 0">
                <Container :flex="1" height="34" color="Colors.blue.shade200">
                  <Text text="':flex 1'" />
                </Container>
                <Container :flex="2" :margin="0 0 0 6" height="34" color="Colors.cyan.shade200">
                  <Text text="':flex 2'" />
                </Container>
              </Row>
              <Row :margin="8 0 0 0">
                <Container width="180" height="56" color="Colors.blueGrey.shade100">
                  <Container :align="Alignment.bottomRight" width="70" height="24" color="Colors.blueGrey">
                    <Text text="':align'" />
                  </Container>
                </Container>
                <Container :margin="0 0 0 8" :theme="ThemeData(colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepOrange))">
                  <FilledButton onPressed="null">
                    <Text text="':theme'" />
                  </FilledButton>
                </Container>
              </Row>
              <Container :margin="8 0 0 0" color="Colors.grey.shade200">
                <Container :margin="12" width="120" height="40" color="Colors.indigo" :center>
                  <Text text="':center 居中'" />
                </Container>
              </Container>
            </Column>
          </DemoSection>

          <DemoSection title="'2. Pipes'" icon="Icons.filter_alt" xml="ctrl.pipesXml"
              description="'管道把值转换与 UI 分离：widthPercent/heightPercent 按屏幕比例计算，stream 跟随流更新，自定义管道可带参数。'">
            <Column crossAxisAlignment="stretch">
              <Text text="'widthPercent → 80% of screen width:'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4 0 0 0" width="80 | widthPercent" height="22" color="Colors.green" :center>
                <Text text="'80%'" />
              </Container>
              <Text :margin="10 0 0 0" text="'heightPercent → 3% of screen height:'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4 0 0 0" width="140" height="3 | heightPercent" color="Colors.deepOrange" />
              <Text :margin="10 0 0 0" text="'stream → ' + (ctrl.clockStream | stream:'--')" />
              <Text :margin="4 0 0 0" text="'counter → ' + (ctrl.counterStream | stream:0).toString()" />
              <Text :margin="4 0 0 0" text="'custom pipe with args → ' + ('This is a long text' | truncate:10)" />
              <Text :margin="4 0 0 0" text="'hello' | translate | uppercase" />
            </Column>
          </DemoSection>

          <DemoSection title="'3. Conditionals'" icon="Icons.alt_route" xml="ctrl.conditionalsXml"
              description="':if / <if> 元素 / :switch 都支持 stream 管道，可以响应式地切换分支。'">
            <Column crossAxisAlignment="start">
              <Text :if="ctrl.showConditionalStream | stream:true" text="':if → true branch'" />
              <if value="ctrl.showConditionalStream | stream:true">
                <Text text="'<if> element → true branch'" />
              </if>
              <elseIf value="false">
                <Text text="'<elseIf>'" />
              </elseIf>
              <else>
                <Text text="'<else>'" />
              </else>
              <Container :switch="ctrl.selectedIndexStream | stream:0" :margin="8 0 0 0">
                <Text :switchCase="0" text="':switch → case 0'" />
                <Text :switchCase="1" text="':switch → case 1'" />
                <Text :switchCase="2" text="':switch → case 2'" />
              </Container>
              <Wrap :margin="8 0 0 0">
                <TextButton onPressed="ctrl.toggleConditional">
                  <Text text="'Toggle :if'" />
                </TextButton>
                <TextButton onPressed="ctrl.cycleSelection">
                  <Text text="'Cycle :switch'" />
                </TextButton>
              </Wrap>
            </Column>
          </DemoSection>

          <DemoSection title="'4. Lists & builders'" icon="Icons.list_alt" xml="ctrl.listsXml"
              description="':repeat 把列表映射成一组 widget；:childBuilder 直接生成 children；:use builder + :itemBuilder 生成 ListView.builder。'">
            <Column crossAxisAlignment="start">
              <Text text="':repeat →'" style="Theme.of(context).textTheme.bodyMedium" />
              <Text :repeat="item of ctrl.items" :margin="2 0 0 8" text="'• ' + item.toString()" />
              <Text :margin="10 0 0 0" text="':childBuilder →'" style="Theme.of(context).textTheme.bodyMedium" />
              <SizedBox height="56">
                <ListView :childBuilder="item of ctrl.items">
                  <Text :margin="2 0 0 8" text="'* ' + item.toString()" />
                </ListView>
              </SizedBox>
              <Text :margin="10 0 0 0" text="':itemBuilder (ListView.builder) →'" style="Theme.of(context).textTheme.bodyMedium" />
              <SizedBox :margin="4 0 0 0" height="150">
                <ListView :use="builder" :itemBuilder="DemoItem item of ctrl.demoItems" itemCount="ctrl.demoItems.length">
                  <ListTile dense="true">
                    <leading>
                      <CircleAvatar radius="14" backgroundColor="Colors.indigo.shade200">
                        <Text text="item.title.substring(0, 1)" />
                      </CircleAvatar>
                    </leading>
                    <title>
                      <Text text="item.title" />
                    </title>
                  </ListTile>
                </ListView>
              </SizedBox>
              <Text :margin="10 0 0 0" text="':childBuilder + stream（点按钮动态加项）→'" style="Theme.of(context).textTheme.bodyMedium" />
              <SizedBox height="90">
                <ListView :childBuilder="item of ctrl.itemsStream | stream">
                  <Text :margin="2 0 0 8" text="'* ' + item.toString()" />
                </ListView>
              </SizedBox>
              <TextButton onPressed="ctrl.addItem">
                <Text text="'添加一项'" />
              </TextButton>
            </Column>
          </DemoSection>

          <DemoSection title="'5. Forms'" icon="Icons.edit_note" xml="ctrl.formsXml"
              description="':formControl + FormGroup 双向绑定表单状态；:formSubmit 在表单无效时自动禁用；校验错误和提交状态通过 stream 展示。'">
            <Column crossAxisAlignment="start">
              <Text text="'Text fields:'" style="Theme.of(context).textTheme.bodyMedium" />
              <TextField :formControl="'name'" decoration="InputDecoration(labelText: 'Name', border: OutlineInputBorder())" />
              <TextField :formControl="'email'" :margin="8 0 0 0" decoration="InputDecoration(labelText: 'Email (required)', border: OutlineInputBorder())" />
              <Text :margin="4 0 0 0" text="'email error → ' + (ctrl.emailErrorStream | stream:'[]')" />
              <ElevatedButton :formSubmit="formGroup" :margin="8 0 0 0">
                <Text text="'Submit'" />
              </ElevatedButton>
              <Text :margin="8 0 0 0" text="'submit enabled → ' + (ctrl.formGroup.submitEnabledStream | stream:false).toString()" />
              <Text :margin="4 0 0 0" text="'last submit → ' + (ctrl.lastSubmitStream | stream:'-')" />
            </Column>
          </DemoSection>

          <DemoSection title="'6. Animation'" icon="Icons.movie_filter" xml="ctrl.animationXml"
              description="'apply-animation 用 tweenMap 驱动属性动画：autoTrigger 自动播放，repeats 循环，也可以通过控制器随时触发。'">
            <Column crossAxisAlignment="center">
              <Text text="'autoTrigger color →'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4" width="200" height="44" :center>
                <Text text="'Color'" />
                <apply-animation name="colorAnim" duration="milliseconds: 800" autoTrigger>
                  <color type="color" begin="Colors.orange" end="Colors.blueAccent" />
                </apply-animation>
              </Container>
              <Text :margin="10 0 0 0" text="'size pulse（勾选循环后无限播放，否则播放一次）→'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4" :center>
                <Text text="'Pulse'" />
                <apply-animation name="sizeAnim" duration="milliseconds: 600" curve="easeOutBack">
                  <width type="double" begin="120" end="200" />
                  <height type="double" begin="40" end="64" />
                </apply-animation>
              </Container>
              <Row :center :margin="4">
                <Switch value="ctrl.loopingStream | stream:false" onChanged="(v) => ctrl.setLooping(v)" />
                <Text :margin="0 0 0 6" text="'循环播放'" />
              </Row>
              <TextButton onPressed="ctrl.playSizeAnim">
                <Text text="'播放 / 重新播放'" />
              </TextButton>
              <Text :margin="10 0 0 0" text="'控制器触发 →'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4" width="200" height="44" :center>
                <Text text="'Replay'" />
                <apply-animation name="fadeAnim" duration="milliseconds: 800">
                  <color type="color" begin="Colors.green" end="Colors.purpleAccent" />
                </apply-animation>
              </Container>
              <TextButton onPressed="ctrl.replayAnimation">
                <Text text="'Replay animation'" />
              </TextButton>
            </Column>
          </DemoSection>

          <DemoSection title="'7. Disable'" icon="Icons.block" xml="ctrl.disableXml"
              description="':disable 在条件为真时禁用点击事件（onPressed 置空）。初始可用，点 3 次后自动禁用。'">
            <Column crossAxisAlignment="center">
              <ElevatedButton :disable="ctrl.enabledStream | stream:false" onPressed="ctrl.increment">
                <Text text="'Increment (auto-disable after 3)'" />
              </ElevatedButton>
              <Text :margin="6" text="'counter → ' + (ctrl.counterStream | stream:0).toString()" />
              <Text text="'enabled → ' + (ctrl.enabledStream | stream:false).toString()" />
            </Column>
          </DemoSection>

          <DemoSection title="'8. Events & gestures'" icon="Icons.touch_app" xml="ctrl.eventsXml"
              description="':onTap / :onLongPress 包装属性自动套上 GestureDetector，事件计数通过 stream 管道实时显示。'">
            <Column crossAxisAlignment="start">
              <Text text="'taps → ' + (ctrl.tapCountStream | stream:0).toString()" />
              <Text :margin="4 0 0 0" text="'long presses → ' + (ctrl.longPressCountStream | stream:0).toString()" />
              <Wrap :margin="8 0 0 0">
                <Container :margin="4" :onTap="ctrl.handleTap" width="110" height="48" color="Colors.blue.shade100">
                  <Text text="'Tap me'" />
                </Container>
                <Container :margin="4" :onLongPress="ctrl.handleLongPress" width="150" height="48" color="Colors.deepOrange.shade100">
                  <Text text="'Long press me'" />
                </Container>
              </Wrap>
            </Column>
          </DemoSection>

          <DemoSection title="'9. Streams & reactivity'" icon="Icons.bolt" xml="ctrl.streamsXml"
              description="':stream 包装属性把任意 Stream 变成响应式数据源，子 widget 通过流里的值自由切换。'">
            <Column crossAxisAlignment="center">
              <SizedBox height="110">
                <Stack :stream="ctrl.selectedTabStream:0:selectedTabValue">
                  <Container :opacity="selectedTabValue == 0 ? 1 : 0.15" color="Colors.blue.shade100">
                    <Text text="'Tab 0 — blue'" />
                  </Container>
                  <Container :opacity="selectedTabValue == 1 ? 1 : 0.15" color="Colors.pink.shade100">
                    <Text text="'Tab 1 — pink'" />
                  </Container>
                  <Container :opacity="selectedTabValue == 2 ? 1 : 0.15" color="Colors.amber.shade100">
                    <Text text="'Tab 2 — amber'" />
                  </Container>
                </Stack>
              </SizedBox>
              <Row :margin="8 0 0 0">
                <TextButton onPressed="() => ctrl.selectTab(0)">
                  <Text text="'0'" />
                </TextButton>
                <TextButton onPressed="() => ctrl.selectTab(1)">
                  <Text text="'1'" />
                </TextButton>
                <TextButton onPressed="() => ctrl.selectTab(2)">
                  <Text text="'2'" />
                </TextButton>
              </Row>
              <Text :margin="10 0 0 0" text="':watch 监听多个流，任一变化就重建 →'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :margin="4" :watch="ctrl.tapCountStream, ctrl.longPressCountStream" :padding="10" color="Colors.teal.shade50">
                <Text text="'taps → ' + (ctrl.tapCountStream | stream:0).toString() + ' · long → ' + (ctrl.longPressCountStream | stream:0).toString()" />
              </Container>
            </Column>
          </DemoSection>

          <DemoSection title="'10. Consumer & Provider'" icon="Icons.account_tree" xml="ctrl.consumerXml"
              description="':consumer 从 Provider 树取数据，子 widget 通过变量直接使用（这里是 PipeProvider）。'">
            <Column crossAxisAlignment="center">
              <Text text="'PipeProvider via :consumer →'" style="Theme.of(context).textTheme.bodyMedium" />
              <Container :consumer="PipeProvider pipeProvider" :margin="8" width="60 | widthPercent" height="26" color="Colors.orange">
                <Text text="pipeProvider.transform(context, 'widthPercent', 60, []).toString()" />
              </Container>
            </Column>
          </DemoSection>

          <DemoSection title="'11. i18n'" icon="Icons.translate" xml="ctrl.i18nXml"
              description="'lib/i18n/*.json 自动生成本地化类，translate 管道按当前 Locale 取翻译，按钮可切换中英文。'">
            <Column crossAxisAlignment="start">
              <Text text="'translate → ' + ('hello' | translate)" />
              <Text :margin="4 0 0 0" text="'translate → ' + ('goodbye' | translate)" />
              <Text :margin="8 0 0 0" text="'locale → ' + (ctrl.localeNameStream | stream:'en')" />
              <FilledButton :margin="8 0 0 0" onPressed="ctrl.toggleLocale">
                <Text text="'Switch locale'" />
              </FilledButton>
            </Column>
          </DemoSection>

          <DemoSection title="'12. 自定义组件 (xmlns)'" icon="Icons.widgets" xml="ctrl.customXml"
              description="'通过 xmlns 导入手写组件后，XML 里可以直接使用，扩展自己的组件库。'">
            <Wrap>
              <DemoBadge text="'自定义组件 A'" color="Colors.orange" />
              <DemoBadge :margin="0 0 0 8" text="'自定义组件 B'" color="Colors.teal" />
              <DemoBadge :margin="0 0 0 8" text="'自定义组件 C'" color="Colors.purple" />
            </Wrap>
          </DemoSection>

          <Container :margin="16 0 8 0" :padding="16" color="Colors.grey.shade100">
            <Text text="'完整源码：demo_page.xml · 生成代码：demo_page.xml.dart · 控制器：demo_page.ctrl.dart'" style="Theme.of(context).textTheme.bodyMedium" />
          </Container>

        </Column>
      </SingleChildScrollView>
    </body>
  </Scaffold>
</DemoPage>
